# Neon pooled connection string (host contains "-pooler"); used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection string (no "-pooler"); used by Prisma for schema push
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Random string, 32+ chars, used to sign session cookies. Generate: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"
